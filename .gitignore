__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.DS_Store
.env

# Generated per-molecule run data (conformers/AIMNet2 geometries/Gaussian
# .gjf+.log/analysis CSVs) -- regenerated by running the pipeline, not
# tracked. Keep the directory itself so beckmann_nbo.config's data-root
# search still finds it.
data/input/*
!data/input/.gitkeep
data/output/*
!data/output/.gitkeep
