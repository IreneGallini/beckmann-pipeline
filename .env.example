# HPC cluster connection settings for scripts/hpc_sync.py

# Copy this file to .env and fill in your real values.

# SSH destination: username@hostname
# You can also use an alias defined in ~/.ssh/config (recommended).
HPC_HOST=username@cluster.hostname

# Absolute (or ~-relative) path on the server where dft_opt_test/ will live.
# The directory will be created automatically on upload if it does not exist.
HPC_REMOTE_DIR=~/beckmann/dft_opt

# Full path to the g16 executable on the server.
# On Citadel: /opt/g16/g16  (set via GAUSS_EXEDIR in ~/.bashrc)
G16_PATH=/opt/g16/g16

# Full path to the NBO7 executable on the server (optional).
# If set, Gaussian uses NBO7 instead of the bundled NBO 3.1, enabling CMO output.
# On Citadel: /opt/nbo7/bin/nbo7.i8.exe
NBOEXE=/opt/nbo7/bin/nbo7.i8.exe
