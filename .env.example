# HPC cluster connection settings for scripts/hpc_sync.py

# Copy this file to .env and fill in your real values.

# SSH destination: username@hostname
# You can also use an alias defined in ~/.ssh/config (recommended).
HPC_HOST=username@cluster.hostname

# Absolute (or ~-relative) path on the server where dft_opt_test/ will live.
# The directory will be created automatically on upload if it does not exist.
HPC_REMOTE_DIR=~/beckmann/dft_opt

# Full path to the g16 executable on the server.
# On Citadel: /opt/g16/g16  (set via GAUSS_EXEDIR in ~/.bashrc)
G16_PATH=/opt/g16/g16

# Any file in the NBO7 bin directory (optional).
# hpc_sync.py adds the parent directory to PATH so Gaussian finds 'g16nbo'.
# On Citadel: /opt/nbo7/bin/g16nbo.i8.exe
NBOEXE=/opt/nbo7/bin/g16nbo.i8.exe

# Directory containing an *executable* copy of gaunbo7 (and gaunbo6) (optional).
# pop=nbo7read is Gaussian's external-program interface (Link 612): it does a
# plain PATH search for the 'gaunbo7' script, which then calls g16nbo -> nbo7.
# On a shared server the vendor-installed gaunbo7 under NBOEXE's directory is
# often root-owned and not executable. Fix: copy it somewhere you own and
# chmod +x, then point this at that directory.
# On Citadel: cp /opt/nbo7/bin/gaunbo7 /opt/nbo7/bin/gaunbo6 ~/beckmann/nbo7_bin/
#             chmod +x ~/beckmann/nbo7_bin/gaunbo7 ~/beckmann/nbo7_bin/gaunbo6
NBO_WRAPPER_DIR=~/beckmann/nbo7_bin
