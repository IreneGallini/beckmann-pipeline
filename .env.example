# HPC cluster connection settings for scripts/hpc_sync.py
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# .env is gitignored — NEVER commit it.

# SSH destination: username@hostname
# You can also use an alias defined in ~/.ssh/config (recommended).
# Example: igallini@submit.cluster.university.edu
HPC_HOST=username@cluster.hostname

# Absolute (or ~-relative) path on the cluster where dft_opt_test/ will live.
# The directory will be created automatically on upload if it does not exist.
# Example: ~/beckmann/dft_opt_test
HPC_REMOTE_DIR=~/beckmann/dft_opt_test
